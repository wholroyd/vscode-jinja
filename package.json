{
	"name": "jinja",
	"version": "0.0.10",
	"publisher": "wholroyd",
	"author": {
		"name": "William Holroyd"
	},
	"license": "MIT",
	"icon": "icon.png",
	"description": "Jinja template language support for Visual Studio Code",
	"displayName": "Jinja",
	"repository": {
		"type": "git",
		"url": "https://github.com/wholroyd/vscode-jinja.git"
	},
	"bugs": {
		"url": "https://github.com/wholroyd/vscode-jinja/issues"
	},
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"keywords": [
		"jinja",
		"jinja2",
		"html",
		"yaml"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"scripts": {
		"test": "npm run test:manifest && npm run test:grammar",
		"test:manifest": "node --test tests/manifest.mjs",
		"test:grammar": "vscode-tmgrammar-test -g tests/stubs/text.html.basic.json -g tests/stubs/source.yaml.json tests/grammar/**/*.jinja"
	},
	"contributes": {
		"configurationDefaults": {
			"emmet.includeLanguages": {
				"jinja-html": "html"
			}
		},
		"snippets": [
			{
				"language": "jinja",
				"path": "./snippets/jinja.json"
			},
			{
				"language": "jinja-html",
				"path": "./snippets/jinja.json"
			},
			{
				"language": "jinja-yaml",
				"path": "./snippets/jinja.json"
			}
		],
		"languages": [
			{
				"id": "jinja-html",
				"aliases": [
					"Jinja HTML",
					"jinja-html"
				],
				"extensions": [
					".html.j2",
					".html.jinja",
					".html.jinja2"
				],
				"configuration": "./jinja-html.configuration.json"
			},
			{
				"id": "jinja-yaml",
				"aliases": [
					"Jinja YAML",
					"jinja-yaml"
				],
				"extensions": [
					".yml.j2",
					".yml.jinja",
					".yml.jinja2",
					".yaml.j2",
					".yaml.jinja",
					".yaml.jinja2",
					".sls"
				],
				"configuration": "./jinja-yaml.configuration.json"
			},
			{
				"id": "jinja",
				"aliases": [
					"Jinja"
				],
				"extensions": [
					".j2",
					".jinja",
					".jinja2"
				],
				"configuration": "./jinja.configuration.json"
			}
		],
		"grammars": [
			{
				"language": "jinja-html",
				"scopeName": "text.html.jinja",
				"path": "./syntaxes/jinja-html.json",
				"embeddedLanguages": {
					"source.js": "javascript",
					"source.css": "css"
				}
			},
			{
				"language": "jinja-yaml",
				"scopeName": "text.yaml.jinja",
				"path": "./syntaxes/jinja-yaml.json"
			},
			{
				"language": "jinja",
				"scopeName": "source.jinja",
				"path": "./syntaxes/jinja.json"
			}
		]
	},
	"devDependencies": {
		"vscode-tmgrammar-test": "^0.1.3"
	}
}
